{
  "name": "drive-lite",
  "version": "1.0.0",
  "private": true,
  "description": "Google Drive Lite — Secure Asset Manager demonstrating AWS best practices",
  "workspaces": [
    "frontend",
    "backend",
    "infra"
  ],
  "scripts": {
    "start:local": "powershell -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "dev:frontend": "npm run dev -w frontend",
    "dev:frontend:aws": "npm run dev:aws -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build -w frontend",
    "build:frontend:aws": "npm run build:aws -w frontend",
    "deploy:frontend": "node scripts/deploy-frontend.mjs",
    "deploy:infra": "npm --prefix infra run cdk deploy -- --context dev=true --context skipCloudFront=true --profile drive-lite",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "author": "",
  "license": "MIT"
}
